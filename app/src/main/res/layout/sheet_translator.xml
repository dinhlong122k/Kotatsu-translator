<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">

	<org.koitharu.kotatsu.core.ui.sheet.AdaptiveSheetHeaderBar
		android:id="@+id/headerBar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:title="@string/ai_translator" />

	<androidx.core.widget.NestedScrollView
		android:id="@+id/scrollView"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:clipToPadding="false"
		android:scrollIndicators="top">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingBottom="@dimen/margin_normal">

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_active"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingHorizontal="@dimen/margin_normal"
				android:paddingVertical="@dimen/margin_small"
				android:text="@string/translator_quick_active" />

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_original"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingHorizontal="@dimen/margin_normal"
				android:paddingVertical="@dimen/margin_small"
				android:text="@string/translator_show_original" />

			<TextView
				android:id="@+id/text_summary"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingHorizontal="@dimen/margin_normal"
				android:paddingVertical="@dimen/margin_small"
				android:textAppearance="?textAppearanceBodyMedium" />

			<org.koitharu.kotatsu.core.ui.widgets.ListItemTextView
				android:id="@+id/button_names"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/translator_pinned_names"
				app:drawableStartCompat="@drawable/ic_edit" />

			<org.koitharu.kotatsu.core.ui.widgets.ListItemTextView
				android:id="@+id/button_genres"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/translator_genres"
				app:drawableStartCompat="@drawable/ic_tag" />

			<org.koitharu.kotatsu.core.ui.widgets.ListItemTextView
				android:id="@+id/button_clear_context"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/translator_clear_series_context"
				app:drawableStartCompat="@drawable/ic_delete" />

			<org.koitharu.kotatsu.core.ui.widgets.ListItemTextView
				android:id="@+id/button_settings"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/settings"
				app:drawableStartCompat="@drawable/ic_settings" />

		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</LinearLayout>
